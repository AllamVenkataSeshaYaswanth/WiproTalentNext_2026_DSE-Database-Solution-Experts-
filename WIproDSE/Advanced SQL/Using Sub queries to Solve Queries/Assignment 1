Display EMPNO, ENAME, DEPTNO of employees who work with SCOTT (Nested Subquery)

SELECT EMPNO, ENAME, DEPTNO
FROM EMP
WHERE DEPTNO = (
    SELECT DEPTNO
    FROM EMP
    WHERE ENAME='SCOTT'
);

